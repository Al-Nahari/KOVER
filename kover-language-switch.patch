+    "404 - error": ["404 -", "خطأ"],
+    "order now": ["اطلب", "الآن"]
+  };
+
+  var ATTRS = {
+    "what are you looking for?": "عمّ تبحث؟",
+    "your name": "الاسم",
+    "email address": "البريد الإلكتروني",
