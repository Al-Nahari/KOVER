diff --git a/assets/css/lang.css b/assets/css/lang.css
new file mode 100644
index 0000000..6619dec
--- /dev/null
+++ b/assets/css/lang.css
@@ -0,0 +1,791 @@
+/* =====================================================================
+   KOVER – language switcher + Arabic / RTL layer
+   Loaded after style.css and nStyle.css. Everything under
+   html[dir="rtl"] only applies when Arabic is selected, so the English
+   site is untouched.
+   ===================================================================== */
+
+/* ---------------------------------------------------------------------
+   1. Language button
+   --------------------------------------------------------------------- */
+.lang-switch {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    gap: 8px;
+    height: 46px;
+    padding: 0 18px;
+    border: 1px solid #d0dbe9;
+    border-radius: 999px;
+    background-color: var(--white-color, #fff);
+    color: var(--title-color, #010f1c);
+    font-family: var(--title-font, "Rubik", sans-serif);
+    font-size: 14px;
+    font-weight: 500;
+    line-height: 1;
+    white-space: nowrap;
+    cursor: pointer;
+    vertical-align: middle;
+    transition: background-color .3s ease, border-color .3s ease, color .3s ease, box-shadow .3s ease;
+}
+
+.lang-switch i {
+    font-size: 15px;
+    color: var(--theme-color, #eb0029);
+    transition: color .3s ease;
+}
+
+.lang-switch:hover,
+.lang-switch:focus-visible {
+    background-color: var(--theme-color, #eb0029);
+    border-color: var(--theme-color, #eb0029);
+    color: #fff;
+    box-shadow: 0 6px 16px rgba(235, 0, 41, .25);
+}
+
+.lang-switch:hover i,
+.lang-switch:focus-visible i {
+    color: #fff;
+}
+
+.lang-switch:focus-visible {
+    outline: 2px solid var(--title-color, #010f1c);
+    outline-offset: 2px;
+}
+
+/* show the name of the language you can switch TO */
+.lang-switch .to-en {
+    display: none;
+}
+
+html[lang="ar"] .lang-switch .to-ar {
+    display: none;
+}
+
+html[lang="ar"] .lang-switch .to-en {
+    display: inline;
+}
+
+.lang-switch .short {
+    display: none;
+}
+
+/* on the red / dark top bars */
+.lang-switch--light {
+    height: 30px;
+    padding: 0 14px;
+    gap: 6px;
+    background-color: rgba(255, 255, 255, .22);
+    border-color: rgba(255, 255, 255, .55);
+    color: #fff;
+    font-size: 13px;
+    margin-inline-end: 10px;
+}
+
+.lang-switch--light i {
+    color: #fff;
+    font-size: 13px;
+}
+
+.lang-switch--light:hover,
+.lang-switch--light:focus-visible {
+    background-color: #fff;
+    border-color: #fff;
+    color: var(--theme-color, #eb0029);
+    box-shadow: none;
+}
+
+.lang-switch--light:hover i,
+.lang-switch--light:focus-visible i {
+    color: var(--theme-color, #eb0029);
+}
+
+.lang-switch--light:focus-visible {
+    outline-color: #fff;
+}
+
+.header-links li.header-lang {
+    line-height: 1;
+}
+
+.header-links li.header-lang .lang-switch {
+    margin-inline-end: 0;
+}
+
+/* inside the mobile drawer */
+.mobile-lang {
+    text-align: center;
+    padding: 6px 0 34px;
+}
+
+.mobile-lang .lang-switch {
+    height: 44px;
+    padding: 0 26px;
+    border-color: var(--theme-color, #eb0029);
+    color: var(--theme-color, #eb0029);
+    font-size: 15px;
+}
+
+.mobile-lang .lang-switch:hover,
+.mobile-lang .lang-switch:focus-visible {
+    color: #fff;
+}
+
+/* small screens: use the short label (EN / ع) so the header never overflows */
+@media (max-width: 575px) {
+    .lang-switch {
+        height: 42px;
+        padding: 0 14px;
+        gap: 6px;
+    }
+
+    .lang-switch .full {
+        display: none;
+    }
+
+    .lang-switch .short {
+        display: inline;
+    }
+
+    .mobile-lang .lang-switch .full {
+        display: inline;
+    }
+
+    .mobile-lang .lang-switch .short {
+        display: none;
+    }
+}
+
+/* fade while the page reloads in the other language */
+html.lang-switching body {
+    opacity: 0;
+    transition: opacity .14s ease;
+}
+
+/* ---------------------------------------------------------------------
+   2. Arabic typography  (Rubik already ships an Arabic subset, so the
+      Arabic text keeps the same look as the English headings)
+   --------------------------------------------------------------------- */
+html[lang="ar"] {
+    --title-font: "Rubik", "Segoe UI", Tahoma, "Noto Sans Arabic", Arial, sans-serif;
+    --body-font: "Rubik", "Segoe UI", Tahoma, "Noto Sans Arabic", Arial, sans-serif;
+    --style-font: "Rubik", "Segoe UI", Tahoma, "Noto Sans Arabic", Arial, sans-serif;
+}
+
+html[lang="ar"] body {
+    line-height: 1.8;
+}
+
+/* Arabic letters must stay joined: never add tracking */
+html[lang="ar"] body *,
+html[lang="ar"] .ls-text-layer {
+    letter-spacing: 0 !important;
+}
+
+/* the red "script" accent words (Lobster Two has no Arabic) */
+html[lang="ar"] .font-style,
+html[lang="ar"] .hero-title .font-style,
+html[lang="ar"] .sub-title,
+html[lang="ar"] .ls-text-layer,
+html[lang="ar"] .ls-button-layer {
+    font-family: var(--title-font) !important;
+    font-style: normal;
+}
+
+html[lang="ar"] .font-style,
+html[lang="ar"] .sub-title {
+    font-weight: 700;
+}
+
+html[lang="ar"] .sub-title {
+    font-size: 19px;
+    text-transform: none;
+}
+
+html[lang="ar"] .hero-title .font-style,
+html[lang="ar"] .ls-text-layer.ls-text-layer {
+    line-height: 1.25 !important;
+}
+
+html[lang="ar"] .as-btn,
+html[lang="ar"] .link-btn,
+html[lang="ar"] .line-btn,
+html[lang="ar"] .main-menu a,
+html[lang="ar"] .breadcumb-title,
+html[lang="ar"] .counter-info,
+html[lang="ar"] .counter-text,
+html[lang="ar"] .about-feature_text,
+html[lang="ar"] .tab-menu1 button,
+html[lang="ar"] .tab-menu2 button {
+    text-transform: none;
+}
+
+html[lang="ar"] .as-btn {
+    font-size: 15px;
+    padding-top: 19px;
+    padding-bottom: 19px;
+}
+
+html[lang="ar"] .main-menu a {
+    font-size: 17px;
+}
+
+html[lang="ar"] .counter-card_number {
+    direction: ltr;
+}
+
+/* phone numbers / e-mails keep their left-to-right reading order */
+html[dir="rtl"] a[href^="mailto:"]:not(.as-social a),
+html[dir="rtl"] a[href^="tel:"],
+html[dir="rtl"] a[href*="wa.me"]:not(.as-social a):not(.header-social a) {
+    direction: ltr;
+    unicode-bidi: isolate;
+    display: inline-block;
+}
+
+/* ---------------------------------------------------------------------
+   3. RTL layout
+   --------------------------------------------------------------------- */
+html[dir="rtl"] body {
+    direction: rtl;
+    text-align: right;
+}
+
+html[dir="rtl"] .text-end {
+    text-align: left !important;
+}
+
+html[dir="rtl"] .text-start {
+    text-align: right !important;
+}
+
+html[dir="rtl"] .text-center {
+    text-align: center !important;
+}
+
+/* ----- header (home) ----- */
+html[dir="rtl"] .header-info {
+    margin-right: 0;
+    margin-left: 25px;
+}
+
+html[dir="rtl"] .header-info:last-child {
+    margin-left: 0;
+}
+
+html[dir="rtl"] .header-info i {
+    margin-right: 0;
+    margin-left: 6px;
+}
+
+html[dir="rtl"] .as-social a {
+    margin-right: 0;
+    margin-left: 5px;
+}
+
+html[dir="rtl"] .as-social a:last-child {
+    margin-left: 0;
+}
+
+html[dir="rtl"] .header-top .as-social a {
+    margin-right: 0;
+    margin-left: 2px;
+}
+
+html[dir="rtl"] .as-social .lang-switch {
+    margin-left: 10px;
+}
+
+html[dir="rtl"] nav ul.main-nav {
+    margin-left: 0;
+    margin-right: -25px;
+}
+
+/* ----- header (inner pages) ----- */
+html[dir="rtl"] .header-layout1:before {
+    left: auto;
+    right: 0;
+}
+
+html[dir="rtl"] .header-layout1:after {
+    right: auto;
+    left: 0;
+}
+
+html[dir="rtl"] .header-layout1 .main-menu {
+    padding-left: 0;
+    padding-right: 130px;
+}
+
+html[dir="rtl"] .header-layout1 .header-top-inner {
+    padding-left: 0;
+    padding-right: 282px;
+}
+
+@media (max-width: 1299px) {
+    html[dir="rtl"] .header-layout1 .main-menu {
+        padding-right: 70px;
+    }
+
+    html[dir="rtl"] .header-layout1 .header-top-inner {
+        padding-right: 222px;
+    }
+}
+
+@media (max-width: 1199px) {
+    html[dir="rtl"] .header-layout1 .main-menu {
+        padding-right: 0;
+        margin-left: 0;
+        margin-right: auto;
+    }
+
+    html[dir="rtl"] .header-layout1 .header-top-inner {
+        padding-right: 0;
+    }
+}
+
+html[dir="rtl"] .header-links li:not(:last-child) {
+    padding: 0 0 0 20px;
+    margin: 0 0 0 17px;
+}
+
+html[dir="rtl"] .header-links li:not(:last-child):before {
+    right: auto;
+    left: 0;
+}
+
+html[dir="rtl"] .header-social a {
+    margin: 0 0 0 10px;
+}
+
+html[dir="rtl"] .header-social a:last-child {
+    margin-left: 0;
+}
+
+html[dir="rtl"] .link-box {
+    margin-left: 0;
+    margin-right: 40px;
+}
+
+/* ----- mobile drawer: opens from the right ----- */
+html[dir="rtl"] .as-menu-wrapper .as-menu-area {
+    left: auto;
+    right: -110%;
+    border-right: 0;
+    border-left: 3px solid var(--theme-color);
+}
+
+html[dir="rtl"] .as-menu-wrapper.as-body-visible .as-menu-area {
+    left: auto;
+    right: 0;
+}
+
+html[dir="rtl"] .as-menu-wrapper .as-menu-toggle {
+    right: auto;
+    left: -16.5px;
+}
+
+html[dir="rtl"] .as-mobile-menu {
+    text-align: right;
+}
+
+html[dir="rtl"] .as-mobile-menu ul li a {
+    padding-left: 0;
+    padding-right: 18px;
+}
+
+html[dir="rtl"] .as-mobile-menu ul li a:before {
+    left: auto;
+    right: 0;
+    margin-right: 0;
+    margin-left: 10px;
+    content: "\f104";
+}
+
+/* ----- scroll-to-top ----- */
+html[dir="rtl"] .scroll-btn,
+html[dir="rtl"] .scrollToTop {
+    right: auto;
+    left: 50px;
+}
+
+@media (max-width: 767px) {
+
+    html[dir="rtl"] .scroll-btn,
+    html[dir="rtl"] .scrollToTop {
+        left: 15px;
+    }
+}
+
+/* ----- search popup ----- */
+html[dir="rtl"] .popup-search-box form input {
+    padding-left: 0;
+    padding-right: 30px;
+}
+
+html[dir="rtl"] .popup-search-box form button {
+    right: auto;
+    left: 12px;
+}
+
+/* ----- arrows / chevrons point the other way ----- */
+html[dir="rtl"] .fa-arrow-right,
+html[dir="rtl"] .fa-arrow-right-long,
+html[dir="rtl"] .fa-long-arrow-right,
+html[dir="rtl"] .fa-angle-right,
+html[dir="rtl"] .fa-chevron-right,
+html[dir="rtl"] .fa-arrow-up-right {
+    transform: scaleX(-1);
+}
+
+html[dir="rtl"] .link-btn i,
+html[dir="rtl"] .line-btn i {
+    margin-left: 0;
+    margin-right: 5px;
+}
+
+/* ----- breadcrumb ----- */
+html[dir="rtl"] .breadcumb-menu li {
+    margin-right: 0;
+    margin-left: 3px;
+    padding-right: 0;
+    padding-left: 5px;
+}
+
+html[dir="rtl"] .breadcumb-menu li:last-child {
+    padding-left: 0;
+    margin-left: 0;
+}
+
+html[dir="rtl"] .breadcumb-menu li:after {
+    content: "\f053";
+    margin-left: 0;
+    margin-right: 10px;
+}
+
+html[dir="rtl"] .breadcumb-shape {
+    right: auto;
+    left: 0;
+}
+
+html[dir="rtl"] .breadcumb-shape img {
+    transform: scaleX(-1);
+}
+
+/* ----- feature strips ----- */
+html[dir="rtl"] .feature-card-wrap:first-child .feature-card {
+    border-right: 0;
+    border-left: 1px dashed var(--gray-color);
+}
+
+html[dir="rtl"] .feature-card-wrap:last-child .feature-card {
+    border-left: 0;
+    border-right: 1px dashed var(--gray-color);
+    justify-content: flex-start;
+}
+
+@media (max-width: 991px) {
+
+    html[dir="rtl"] .feature-card-wrap:first-child .feature-card,
+    html[dir="rtl"] .feature-card-wrap:last-child .feature-card {
+        border: 0;
+        justify-content: center;
+    }
+}
+
+html[dir="rtl"] .feature-grid:not(:last-child) {
+    border-right: 0;
+    border-left: 1px dashed var(--gray-color);
+}
+
+@media (max-width: 767px) {
+    html[dir="rtl"] .feature-grid:not(:last-child) {
+        border-left: 0;
+    }
+}
+
+html[dir="rtl"] .feature-box-wrap,
+html[dir="rtl"] .feature-box {
+    text-align: right;
+}
+
+/* ----- counters ----- */
+html[dir="rtl"] .counter-card_icon {
+    padding-left: 0;
+    padding-right: 24px;
+    text-align: left;
+}
+
+html[dir="rtl"] .counter-card_icon:before {
+    left: auto;
+    right: 0;
+}
+
+/* ----- check lists ----- */
+html[dir="rtl"] .checklist ul {
+    text-align: right;
+}
+
+html[dir="rtl"] .checklist li {
+    padding-left: 0;
+    padding-right: 24px;
+}
+
+html[dir="rtl"] .checklist li:before {
+    left: auto;
+    right: 0;
+}
+
+html[dir="rtl"] .checklist.style3 li {
+    padding-left: 23px;
+    padding-right: 54px;
+}
+
+html[dir="rtl"] .checklist.style3 li:before {
+    left: auto;
+    right: 23px;
+}
+
+/* ----- about ----- */
+html[dir="rtl"] .about-card {
+    padding-left: 0;
+    padding-right: 16px;
+}
+
+html[dir="rtl"] .checklist-wrap,
+html[dir="rtl"] .about-counter1,
+html[dir="rtl"] .btn-wrap {
+    direction: rtl;
+}
+
+/* ----- footer ----- */
+html[dir="rtl"] .footer-top .footer-logo {
+    border-right: 0;
+    border-left: 1px solid var(--border-color);
+}
+
+@media (max-width: 1199px) {
+    html[dir="rtl"] .footer-top .footer-logo {
+        border-left: 0;
+    }
+}
+
+html[dir="rtl"] .footer-widget .widget_title:after {
+    left: auto;
+    right: 0;
+    background-image: linear-gradient(to left, var(--theme-color), transparent);
+}
+
+html[dir="rtl"] .footer-widget.widget_nav_menu a,
+html[dir="rtl"] .footer-widget.widget_meta a,
+html[dir="rtl"] .footer-widget.widget_pages a,
+html[dir="rtl"] .footer-widget.widget_archive a,
+html[dir="rtl"] .footer-widget.widget_categories a {
+    padding: 0 23px 0 0;
+}
+
+html[dir="rtl"] .footer-widget.widget_nav_menu a:before,
+html[dir="rtl"] .footer-widget.widget_meta a:before,
+html[dir="rtl"] .footer-widget.widget_pages a:before,
+html[dir="rtl"] .footer-widget.widget_archive a:before,
+html[dir="rtl"] .footer-widget.widget_categories a:before {
+    left: auto;
+    right: 0;
+    content: "\f060";
+}
+
+html[dir="rtl"] .footer-widget.widget_nav_menu a:hover:before,
+html[dir="rtl"] .footer-widget.widget_meta a:hover:before,
+html[dir="rtl"] .footer-widget.widget_pages a:hover:before,
+html[dir="rtl"] .footer-widget.widget_archive a:hover:before,
+html[dir="rtl"] .footer-widget.widget_categories a:hover:before {
+    transform: translateX(-3px);
+}
+
+html[dir="rtl"] .info-box_icon {
+    margin-right: 0;
+    margin-left: 10px;
+}
+
+html[dir="rtl"] .footer-links li {
+    padding-right: 0;
+    padding-left: 15px;
+    margin-right: 0;
+    margin-left: 10px;
+}
+
+html[dir="rtl"] .footer-links li:after {
+    right: auto;
+    left: 0;
+}
+
+html[dir="rtl"] .footer-links li:last-child {
+    margin-left: 0;
+    padding-left: 0;
+}
+
+html[dir="rtl"] .copyright-text {
+    text-align: right;
+}
+
+@media (max-width: 991px) {
+    html[dir="rtl"] .copyright-text {
+        text-align: center;
+    }
+}
+
+/* ----- forms ----- */
+html[dir="rtl"] select,
+html[dir="rtl"] .form-control,
+html[dir="rtl"] .form-select,
+html[dir="rtl"] textarea,
+html[dir="rtl"] input {
+    padding-left: 45px;
+    padding-right: 25px;
+    text-align: right;
+}
+
+html[dir="rtl"] input[type="email"],
+html[dir="rtl"] input[type="tel"] {
+    direction: rtl;
+}
+
+html[dir="rtl"] .form-group>i {
+    right: auto;
+    left: 25px;
+}
+
+html[dir="rtl"] [class*=col-].form-group>i {
+    right: auto;
+    left: calc(var(--bs-gutter-x) / 2 + 25px);
+}
+
+html[dir="rtl"] .form-select,
+html[dir="rtl"] select {
+    background-position: left 26px center;
+}
+
+html[dir="rtl"] .contact-info,
+html[dir="rtl"] .contact-info_text {
+    text-align: center;
+}
+
+/* ----- product pages ----- */
+html[dir="rtl"] .product-inner-list li {
+    padding-left: 0;
+    padding-right: 15px;
+}
+
+html[dir="rtl"] .product-inner-list li:before {
+    left: auto;
+    right: 0;
+}
+
+html[dir="rtl"] .summary-content,
+html[dir="rtl"] .product-about {
+    padding-left: 0;
+    padding-right: 36px;
+}
+
+@media (max-width: 1299px) {
+
+    html[dir="rtl"] .summary-content,
+    html[dir="rtl"] .product-about {
+        padding-right: 0;
+    }
+}
+
+html[dir="rtl"] .menu-list_title:after {
+    left: auto;
+    right: calc(100% + 10px);
+}
+
+html[dir="rtl"] .menu-list-img {
+    margin-left: 0;
+    margin-right: 31px;
+}
+
+html[dir="rtl"] .menu-list-img.left {
+    margin-right: 0;
+    margin-left: 31px;
+}
+
+html[dir="rtl"] .tab-menu1,
+html[dir="rtl"] .tab-menu2 {
+    direction: rtl;
+}
+
+/* ----- carousels (slick) keep their own internal direction; only the text flips ----- */
+html[dir="rtl"] .slick-slide {
+    direction: rtl;
+}
+
+/* ----- sections whose picture sits on a decorative shape: keep the picture
+   on its original side, only the text reads right-to-left ----- */
+html[dir="rtl"] .row:has(> div > .text-end > .about-img) {
+    direction: ltr;
+}
+
+html[dir="rtl"] .row:has(> div > .text-end > .about-img) > div {
+    direction: rtl;
+}
+
+html[dir="rtl"] .row:has(> div > .text-end > .about-img) .text-end {
+    direction: ltr;
+    text-align: right !important;
+}
+
+/* the closed drawer sits off-screen on the right: don't let it widen the page */
+html[dir="rtl"] .as-menu-wrapper {
+    overflow: hidden;
+}
+
+/* the about picture is intentionally wider than its column; in RTL that
+   overflow would become scrollable, so clip it */
+html[dir="rtl"] div:has(> .container > .row > div > .text-end > .about-img) {
+    overflow-x: clip;
+}
+
+/* decorative / slider elements are wider than the viewport by design; in RTL
+   that overflow is on the scrollable side, so clip it */
+html[dir="rtl"],
+html[dir="rtl"] body {
+    overflow-x: clip;
+    max-width: 100%;
+}
+
+/* ----- accordion (about page) ----- */
+html[dir="rtl"] .accordion-card .accordion-button {
+    padding: 10px 30px 10px 50px;
+    text-align: right;
+}
+
+html[dir="rtl"] .accordion-card .accordion-button:after {
+    right: auto;
+    left: 10px;
+    margin-left: 0;
+}
+
+@media (max-width: 767px) {
+    html[dir="rtl"] .accordion-card .accordion-button {
+        padding: 10px 20px 10px 50px;
+    }
+}
+
+/* home page, phones: make room for the language button next to the menu icon */
+@media (max-width: 575px) {
+    .header-layout2 .col-auto .header-logo a img {
+        width: 165px !important;
+        height: auto;
+    }
+
+    .header-layout2 .header-button {
+        gap: 8px;
+    }
+}
+
+@media (max-width: 380px) {
+    .header-layout2 .col-auto .header-logo a img {
+        width: 130px !important;
+    }
+}
